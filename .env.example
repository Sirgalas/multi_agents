# AnyModel API Configuration
ANYMODEL_API_KEY=your_api_key_here
ANYMODEL_BASE_URL=https://anymodel.org/v1

# DeepSeek Harness Configuration
HARNESS_CONTEXT=./docker/harness/config

# PostgreSQL Database Configuration
POSTGRES_DB=orchestrator_db
POSTGRES_USER=orchestrator_user
POSTGRES_PASSWORD=strong_password_here
POSTGRES_PORT=5432

# Spring Boot Application Settings
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orchestrator_db
SPRING_DATASOURCE_USERNAME=orchestrator_user
SPRING_DATASOURCE_PASSWORD=strong_password_here

# Initial Application Admin Credentials
APP_ADMIN_USER_NAME=admin
APP_ADMIN_USER_PASSWORD=admin123

# Output Directory for Generated Code & ZIP Archives
OUTPUT_DIR=./output