# AnyModel API базовая конфигурация
ANYMODEL_API_KEY=your_anymodel_api_key_here
ANYMODEL_BASE_URL=https://anymodel.org/v1

# Общие настройки для всех агентов (опционально)
AGENTS_ALL_URL=https://anymodel.org/v1
AGENTS_ALL_TOKEN=your_token_here

# Индивидуальные настройки агентов
# 1. Интервьюер
INTERVIEWER_URL=
INTERVIEWER_TOKEN=
INTERVIEWER_MODEL=ag/gemini-3.7-flash-high

# 2. Главный архитектор
ARCHITECT_URL=
ARCHITECT_TOKEN=
ARCHITECT_MODEL=cc/claude-sonnet-4-6

# 3. Бэкенд-аналитик
BACKEND_ANALYST_URL=
BACKEND_ANALYST_TOKEN=
BACKEND_ANALYST_MODEL=cc/claude-sonnet-4-6

# 4. Фронтенд-аналитик
FRONTEND_ANALYST_URL=
FRONTEND_ANALYST_TOKEN=
FRONTEND_ANALYST_MODEL=cc/claude-sonnet-4-6

# 5. UI/UX Дизайнер
DESIGNER_URL=
DESIGNER_TOKEN=
DESIGNER_MODEL=cc/claude-sonnet-4-6

# 5. Бэкенд-разработчик
BACKEND_DEVELOPER_URL=
BACKEND_DEVELOPER_TOKEN=
BACKEND_DEVELOPER_MODEL=ag/gemini-3.7-flash-high

# 6. Фронтенд-разработчик
FRONTEND_DEVELOPER_URL=
FRONTEND_DEVELOPER_TOKEN=
FRONTEND_DEVELOPER_MODEL=ag/gemini-3.7-flash-high

# 7. Тестировщик
TESTER_URL=
TESTER_TOKEN=
TESTER_MODEL=ag/gemini-3.7-flash-high

# 9. Инфраструктурный хелпер
HELPER_URL=
HELPER_TOKEN=
HELPER_MODEL=ag/gemini-3.7-flash-high

# PostgreSQL конфигурация
POSTGRES_DB=orchestrator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_here
POSTGRES_PORT=5432

# Spring конфигурация
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orchestrator
SERVER_PORT=8080

# Администратор по умолчанию
APP_ADMIN_USER_NAME=admin
APP_ADMIN_USER_PASSWORD=admin123

# DeepSeek Harness
HARNESS_CONTEXT=./docker/harness

# Локальный оффлайн-сервер документации DevDocs (MCP)
MCP_DOCS_PORT=8888
MCP_DOCS_BASE_URL=http://localhost:8888

# Каталог вывода сгенерированных проектов и ZIP-архивов
OUTPUT_DIRECTORY=./output